  <Identity Name="Richard.XboxGpuLab" Publisher="CN=XboxGpuLab" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="aa79f603-c472-46c4-a3b0-7d2661e6e3e5" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties><DisplayName>Xbox Native GPU Lab</DisplayName><PublisherDisplayName>Xbox GPU Lab</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" /></Dependencies>
